{
  "id": "media-tools",
  "name": "Media Downloader",
  "version": "1.0.0",
  "description": "YouTube, MP4, MP3, AV1",
  "author": "PhaiXD",
  "icon": "🎬",
  "min_core_version": "2.0.0",
  "tools": [
    {
      "id": "yt-mp4",
      "name": "YouTube to MP4",
      "description": "Download YouTube videos as MP4",
      "icon": "🎬",
      "category": "video-audio",
      "mode": "fetch",
      "inputs": {
        "type": "url",
        "placeholder": "https://youtube.com/..."
      },
      "command": "plugin.bat",
      "args": ["yt-mp4", "{input_file}", "{output_file}"],
      "output_ext": ".mp4"
    },
    {
