    },
    {
      "id": "jpg-webp",
      "name": "JPG to WEBP",
      "description": "Convert JPG images to WebP format",
      "icon": "🖼️",
      "category": "image",
      "mode": "convert",
      "inputs": {
        "type": "file",
        "accept": [".jpg", ".jpeg"]
      },
      "command": "plugin.bat",
      "args": ["jpg-webp", "{input_file}", "{output_file}"],
      "output_ext": ".webp"
    },
    {
      "id": "png-webp",
      "name": "PNG to WEBP",
      "description": "Convert PNG images to WebP format",
